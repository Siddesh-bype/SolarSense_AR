# Copy this file to .env and fill in values before running.

# PVGIS REST API base URL (do not change unless PVGIS releases a new version)
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_2

# Path to the YOLOv8 model weights file.
# "yolov8n.pt" will be auto-downloaded by ultralytics on first run.
# Replace with your fine-tuned .pt file path for production.
YOLO_MODEL_PATH=yolov8n.pt

# YOLOv8 confidence threshold (0.0 – 1.0)
YOLO_CONF_THRESHOLD=0.35

# CORS: comma-separated list of allowed origins (use * for hackathon demo)
CORS_ORIGINS=*

# Server host/port (used by uvicorn in main.py)
HOST=0.0.0.0
PORT=8000
