<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Demo/dev build: cleartext allowed everywhere so the app can reach
         a local report backend on the user's laptop (any LAN IP) without
         having to enumerate each subnet. HTTPS is still used for PVGIS. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
